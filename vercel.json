{
  "framework": null,
  "functions": {
    "api/appilot.js": {
      "maxDuration": 300
    },
    "api/tts.js": {
      "maxDuration": 30
    },
    "api/auth.js": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/editor.html"
    },
    {
      "source": "/editor",
      "destination": "/editor.html"
    },
    {
      "source": "/lernen",
      "destination": "/lernen.html"
    },
    {
      "source": "/lern-editor",
      "destination": "/lern-editor.html"
    },
    {
      "source": "/anmelden",
      "destination": "/anmelden.html"
    }
  ]
}
